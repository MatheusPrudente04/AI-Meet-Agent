# ── LLM ──────────────────────────────────────────────────────────────
LLM_PROVIDER=
OLLAMA_MODEL=
OLLAMA_BASE_URL=

# ── Whisper ───────────────────────────────────────────────────────────
WHISPER_MODEL=
WHISPER_LANGUAGE=
WHISPER_DEVICE=

# ── Storage ───────────────────────────────────────────────────────────
STORAGE_PATH=
AUDIO_STORAGE_PATH=
MAX_AUDIO_SIZE_MB=

# ── Bot de reunião ────────────────────────────────────────────────────
BOT_NAME=
BOT_HEADLESS=
BOT_CHROME_PROFILE=

# ── Diarização ────────────────────────────────────────────────────────
USE_REAL_DIARIZATION=
HUGGINGFACE_TOKEN=

# ── SMTP (envio de tarefas por e-mail) ────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Quem recebe o alerta de API fora do ar (scripts/health_alert.py)
ALERT_EMAIL=

# ── Banco de Dados ────────────────────────────────────────────────
APP_MODE=collab
MONGO_URI=mongodb://localhost:27018
MONGO_DB=

# TesteBotVivo
MEET_TEST_URL=
# Transcrição local (faster-whisper); "api" exige OPENAI_API_KEY
WHISPER_TRANSCRIBER=local

# ── Serviços do docker compose vistos a partir do host (bot-worker) ──
REDIS_URL=redis://localhost:6380/0
API_PORT=8001
# Endereço da API visto pelo navegador do bot (vazio = http://127.0.0.1:API_PORT)
CAPTURE_ENDPOINT=
# tiny | base | small | medium | large-v3
WHISPER_LOCAL_MODEL=medium
# Diagnóstico: salva amostras do DOM do Meet em data/audio/<id>.dom.jsonl
BOT_DEBUG_DOM=false

# ── Segurança da API (ADR-007) ────────────────────────────────────────
# Obrigatória em APP_MODE=collab. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
MAX_UPLOAD_MB=500

# ── Login de usuários (ADR-011) ───────────────────────────────────────
# Sessões ficam na coleção `sessions` do MongoDB. Depois de cadastrar quem
# deve entrar, feche o cadastro com ALLOW_REGISTRATION=false.
SESSION_DAYS=30
ALLOW_REGISTRATION=true
CAPTURE_MAX_CHUNK_MB=10
CAPTURE_MAX_SESSION_MB=1024

# ── Credenciamento do bot pela interface (ADR-018) ─────────────────────
# Opcional: com os dois, o botão "Credenciar bot" tenta entrar sozinho na conta do Google do
# bot. Sem eles, ou se o Google pedir verificação, alguém conclui na tela do bot (BOT_VNC_URL).
BOT_GOOGLE_EMAIL=
BOT_GOOGLE_PASSWORD=
BOT_VNC_URL=http://localhost:6080/vnc.html?autoconnect=true&resize=scale

# ── Concorrência (ADR-015) ────────────────────────────────────────────
# Processos da API (o compose usa 2); chats simultâneos ao LLM por processo;
# envios, bots e perguntas por usuário por minuto (0 = sem limite).
API_WORKERS=1
CHAT_MAX_CONCURRENT=2
RATE_LIMIT_PER_MINUTE=30

# ── Contexto do LLM (ADR-010) ─────────────────────────────────────────
# Caracteres de transcrição por pedido (~2,6 por token). Acima disso o resumo
# é feito em partes e o chat recebe só os trechos relevantes.
LLM_CONTEXT_CHARS=30000
OLLAMA_NUM_CTX_MAX=32768

# ── Google Calendar (opcional): título da reunião a partir da agenda ──
ENABLE_CALENDAR=false

# ── Produção num servidor (docker-compose.prod.yml, S11-2) ────────────
# Domínio da interface; a API fica em api.<DOMAIN>. O DNS dos dois aponta para o servidor.
DOMAIN=
